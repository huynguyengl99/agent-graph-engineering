# The backend's own environment. Each service reads the .env next to it, so
# nothing here reaches the agent: a variable one service sets and another reads
# by accident is how the agent came to believe it was a Django service.
#
# DJANGO_SETTINGS_MODULE is deliberately absent. manage.py, asgi.py and wsgi.py
# already default it to the dev settings, and pytest.ini picks the test ones.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres and Redis run from docker-compose.yml, which owns the credentials
# themselves. Change them there and here together.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage_dev
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins allowed to post session-authenticated forms, such as the admin.
# Behind a proxy this is the app's origin, not the backend's.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# Where the agent listens. The backend is its only caller.
AGENT_WS_URL=ws://localhost:8001

# Shared secret for that connection. The agent refuses a handshake without it,
# so this must match ASSISTANT_AGENT_TOKEN in agent/.env and web/.env. Empty on
# every side means the agent accepts any caller, which is only safe because
# nothing but the backend can reach it.
ASSISTANT_AGENT_TOKEN=
