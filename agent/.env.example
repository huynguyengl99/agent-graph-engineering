# The agent's own environment. It reads the .env next to it and never the
# backend's, which is what keeps the backend's DJANGO_SETTINGS_MODULE out of
# this process: chanx reads that variable to decide which integration it is on,
# and a stray one makes every topic broadcast fail.

# Leave blank to run on the built-in scripted model, which makes no HTTP calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The deployment's default model for each purpose, as "provider:name". A user's
# own choice overrides these one slot at a time.
ASSISTANT_DECISION_MODEL=openai:gpt-4o-mini
ASSISTANT_ANSWER_MODEL=openai:gpt-4o

# How long a single model call may take, in seconds. The provider SDKs default
# to 600, which is far too long for someone waiting on an answer.
ASSISTANT_MODEL_TIMEOUT=60
# A backstop against a routing cycle, not a tuning knob.
ASSISTANT_GRAPH_RECURSION_LIMIT=150

# Must match ASSISTANT_AGENT_TOKEN in backend/.env and web/.env.
ASSISTANT_AGENT_TOKEN=

# Redis carries topic broadcasts, so a node's event reaches every subscriber
# rather than the one socket that started the run. Unset keeps them in this
# process, which is enough for a single worker.
REDIS_URL=redis://localhost:6379/0

# Where paused runs live. Unset falls back to memory, which loses every
# approval waiting on a human when the process restarts.
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage_dev
CHECKPOINT_POOL_SIZE=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the agent writes finished spans, one file per run. Empty keeps them in
# memory only, so a restart loses them. Unredacted: they stay on this machine.
ASSISTANT_TRACE_DIR=.traces

# Strip message bodies from spans on their way to a collector. Off by default,
# so the dashboard shows what the model was actually sent. Turn it on when the
# collector is somewhere you do not control: `gen_ai.input.messages` carries the
# customer's own words. Never applies to the local files.
ASSISTANT_TRACE_REDACT_EXPORTS=false

# Optional: forward traces to any OTLP backend (Langfuse, Jaeger, ...). Unset
# means traces stay local, at GET /traces/{run_id}.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
