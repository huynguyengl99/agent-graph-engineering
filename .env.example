# Database
POSTGRES_DB=triage_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=helpdesk.config.settings.dev

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret between the backend and the agent. The agent refuses a
# handshake without it; unset on both sides means it accepts every caller,
# which is only safe because nothing but the backend can reach it.
ASSISTANT_AGENT_TOKEN=

# How long a single model call may take, in seconds. The provider SDKs default
# to 600, which is far too long for someone waiting on an answer.
ASSISTANT_MODEL_TIMEOUT=60

# OpenAI (for agent)
# Leave blank to run the agent with the built-in scripted model.
OPENAI_API_KEY=

# Optional: forward agent traces to any OTLP backend (Langfuse, Jaeger, ...).
# Unset means traces stay in memory at GET /traces/{ticket_id}.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Where paused agent runs live. Defaults to DATABASE_URL; unset means
# in-memory, which loses every approval waiting on a human on restart.
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triage_dev
